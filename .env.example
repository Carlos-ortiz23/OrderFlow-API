# Variables de entorno para OrderFlow API

# Base de datos
DATABASE_URL=postgresql://postgres:password@localhost:5432/orderflow

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=1h

# API
PORT=3000
NODE_ENV=development
PUBLIC_API_URL=http://localhost:3000

# LLM Provider (OpenAI, DeepSeek, Groq)
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Telegram Bot Creation (MTProto API)
# Obtén estas credenciales en https://my.telegram.org/apps
# Genera la sesión con: node scripts/generate-telegram-session.js
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_SESSION=your_session_string_here
